{
  "version": 2,
  "regions": ["bom1"],
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],

  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reset-daily",
      "schedule": "30 18 * * *"
    }
  ]
}
